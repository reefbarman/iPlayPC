From: Steam-Link-PS5
Subject: negotiation: report the client display's real resolution

The system info sent with the client capabilities hard-coded VideoDisplayX/Y
as 1920x1080, so a PS5 on a 4K TV told the host it had a 1080p display, on
top of the 1080p cap the application used to send. Add displayWidth/Height to
IHS_SessionConfig; the application fills it with the console's output size
and the system info reports it. 0 keeps the old 1920x1080.

--- a/include/ihslib/session.h
+++ b/include/ihslib/session.h
@@ -67,6 +67,12 @@
      */
     int32_t refreshRateNum;
     int32_t refreshRateDen;
+    /**
+     * The client display's resolution, reported to the host as VideoDisplayX/Y in the
+     * system info. 0 keeps the old fixed 1920x1080.
+     */
+    int32_t displayWidth;
+    int32_t displayHeight;
 } IHS_SessionConfig;
 
 typedef struct IHS_StreamSessionCallbacks {
--- a/src/session/channels/ch_control_negotiation.c
+++ b/src/session/channels/ch_control_negotiation.c
@@ -185,13 +185,20 @@
 
     CStreamingClientCaps clientCaps = CSTREAMING_CLIENT_CAPS__INIT;
 
-    clientCaps.system_info = "\"SystemInfo\"\n{\n\t\"OSType\"\t\t\"-197\"\n\t\"CPUID\"\t\t\"ARM\"\n"
-                             "\t\"CPUGhz\"\t\t\"0.000000\"\n\t\"PhysicalCPUCount\"\t\"1\"\n"
-                             "\t\"LogicalCPUCount\"\t\"1\"\n\t\"SystemRAM\"\t\t\"263\"\n"
-                             "\t\"VideoVendorID\"\t\"0\"\n\t\"VideoDeviceID\"\t\"0\"\n"
-                             "\t\"VideoRevision\"\t\"0\"\n\t\"VideoRAM\"\t\t\"0\"\n"
-                             "\t\"VideoDisplayX\"\t\"1920\"\n\t\"VideoDisplayY\"\t\"1080\"\n"
-                             "\t\"VideoDisplayNameID\"\t\"JN-MD133BFHDR\"\n}\n";
+    // The display size is the client's real one when the application knows it (a 4K TV, say),
+    // not a fixed 1920x1080: the host takes it into account when it picks the stream size.
+    char systemInfo[640];
+    snprintf(systemInfo, sizeof(systemInfo),
+             "\"SystemInfo\"\n{\n\t\"OSType\"\t\t\"-197\"\n\t\"CPUID\"\t\t\"ARM\"\n"
+             "\t\"CPUGhz\"\t\t\"0.000000\"\n\t\"PhysicalCPUCount\"\t\"1\"\n"
+             "\t\"LogicalCPUCount\"\t\"1\"\n\t\"SystemRAM\"\t\t\"263\"\n"
+             "\t\"VideoVendorID\"\t\"0\"\n\t\"VideoDeviceID\"\t\"0\"\n"
+             "\t\"VideoRevision\"\t\"0\"\n\t\"VideoRAM\"\t\t\"0\"\n"
+             "\t\"VideoDisplayX\"\t\"%d\"\n\t\"VideoDisplayY\"\t\"%d\"\n"
+             "\t\"VideoDisplayNameID\"\t\"JN-MD133BFHDR\"\n}\n",
+             ihsConf.displayWidth > 0 && ihsConf.displayHeight > 0 ? (int) ihsConf.displayWidth : 1920,
+             ihsConf.displayWidth > 0 && ihsConf.displayHeight > 0 ? (int) ihsConf.displayHeight : 1080);
+    clientCaps.system_info = systemInfo;
     PROTOBUF_C_SET_VALUE(clientCaps, system_can_suspend, true);
     {
         int32_t maxBitrate = ihsConf.maxBitrateKbps > 0 ? ihsConf.maxBitrateKbps : 30000;
